# Supabase Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Database Configuration (for direct connections if needed)
DATABASE_URL=postgresql://[user]:[password]@db.[project-ref].supabase.co:5432/postgres

# Optional: Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: External API Keys
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Environment
NODE_ENV=development
# NODE_ENV=production

# Application Settings
APP_NAME="Public Project Management System"
APP_URL=http://localhost:8000
# APP_URL=https://your-domain.com

# Security
SESSION_SECRET=generate-a-random-secret-key
JWT_SECRET=generate-another-random-secret

# File Upload Settings
MAX_FILE_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xlsx,xls

# Logging
LOG_LEVEL=info
# LOG_LEVEL=debug (for development)
# LOG_LEVEL=error (for production)
